# Copy to .env.local for local development. On Vercel these are set per environment
# (the Supabase Vercel integration fills the first four automatically).

# Supabase project (Project Settings -> API Keys). New-style keys preferred; legacy names also work:
# NEXT_PUBLIC_SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server-only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_...

# Public URL of this deployment (used in auth redirects and invite emails).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Show "Sign in with Microsoft" (requires the Azure provider in Supabase Auth).
NEXT_PUBLIC_AZURE_SSO_ENABLED=false

# Claude API key for AI-drafted exec summaries (server-only). Leave empty to hide the button.
ANTHROPIC_API_KEY=
# Optional override; defaults to claude-opus-5-5.
# EXEC_SUMMARY_MODEL=claude-opus-5-5
